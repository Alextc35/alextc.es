{
  "name": "alejandro-tellez-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:build": "node scripts/check-build.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src build tests scripts/*.mjs vite.config.ts playwright.config.ts index.html tsconfig.json package.json .prettierrc.json .github/workflows/*.yml",
    "format:check": "prettier --check src build tests scripts/*.mjs vite.config.ts playwright.config.ts index.html tsconfig.json package.json .prettierrc.json .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "lucide-react": "1.74.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
